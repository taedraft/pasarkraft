# PasarKraft Database Configuration
PK_DB_HOST=YOUR_PK_DB_HOST
PK_DB_USER=YOUR_PK_DB_USER
PK_DB_PASSWORD=YOUR_PK_DB_PASSWORD
PK_DB_NAME=YOUR_PK_DB_NAME

# Recommender API Configuration (Optional)
PK_API_BASE=YOUR_PK_API_BASE
PK_API_KEY=YOUR_PK_API_KEY
PK_PYTHON_BIN=python

# Gemini AI API Configuration
# Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gmail SMTP (password reset OTP)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
PK_SMTP_HOST=smtp.gmail.com
PK_SMTP_PORT=465
PK_SMTP_USER=your.email@gmail.com
PK_SMTP_PASS=your_gmail_app_password
PK_SMTP_FROM=your.email@gmail.com
PK_SMTP_FROM_NAME=PasarKraft
